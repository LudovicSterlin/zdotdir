#!/bin/zsh
###
# .zstylerc - zstyle settings for features/plugins that need them.
###

#
# Antidote
#

zstyle ':antidote:bundle' file ${ZDOTDIR:-~}/.zplugins.txt
zstyle ':antidote:bundle' use-friendly-names 'yes'
zstyle ':antidote:plugin:*' defer-options '-p'

#
# Prompt
#

# Use powerlevel10k. Without this, zephyr's prompt plugin defaults to
# (starship zephyr), and since starship isn't installed it calls the builtin
# `prompt` with an unknown theme, which dumps usage text to the console.
zstyle ':zephyr:plugin:prompt' theme 'p10k'

#
# Editor
#

# Expand ... to ../..
zstyle ':prezto:module:editor' dot-expansion 'yes'

# Set this to whatever you want to use to edit a command
zstyle :zle:edit-command-line editor hx
